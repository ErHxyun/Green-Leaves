# Docker Compose only. Use separate random hex values (URL-safe).
POSTGRES_PASSWORD=
ADMIN_API_KEY=
CORS_ORIGIN=http://localhost:8080
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Select openrouter for DeepSeek; keys belong only on the server.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

PUBLIC_CHAT_ENABLED=true
PUBLIC_CHAT_DAILY_LIMIT=50
